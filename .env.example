# ==============================================================================
# VaultPay Environment Configuration
# ==============================================================================

# Terminal 3 Network (T3N) Configuration
# Sign up at: https://go.terminal3.io/adk-community (Campaign Code: AITinkerer)
T3N_ACCOUNT_ID=your-terminal-3-account-id
T3N_PRIVATE_API_KEY=your-terminal-3-private-api-key
T3N_RPC_URL=https://rpc.t3n.network

# Execution Mode:
# Set MOCK_T3N=1 to run the Intel SGX hardware TEE emulator locally (zero latency, offline fail-proof)
# Set MOCK_T3N=0 to connect directly to the live Terminal 3 Network
MOCK_T3N=1

# Spending Policy Knobs:
SESSION_BUDGET_USDC=5000.00
PER_CALL_CAP_USDC=1000.00
APPROVED_ALLOWLIST=CloudForge,DataStream AI,Xendit,ComputePool KL

# Payment Relay / Xendit Sandbox Configuration
XENDIT_SECRET_KEY=xnd_development_your_key_here
PAYMENT_RELAY_PORT=8787
MOCK_RELAY=1
