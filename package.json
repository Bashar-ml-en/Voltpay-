{
  "name": "vaultpay",
  "version": "1.0.0",
  "private": true,
  "description": "VaultPay: Autonomous B2B Procurement Agent with Terminal 3 TEE Hardware Enclave Guardrails and Model Context Protocol (MCP)",
  "scripts": {
    "dev": "npm run dev --prefix dashboard",
    "test": "npm run test --prefix agent",
    "test:all": "npm run test --prefix agent && npm run mcp:verify --prefix agent",
    "mcp:start": "npm run mcp:start --prefix agent",
    "mcp:verify": "npm run mcp:verify --prefix agent",
    "build:agent": "npm run build --prefix agent",
    "build:dashboard": "npm run build --prefix dashboard",
    "build": "npm run build --prefix dashboard",
    "build:all": "npm run build --prefix agent && npm run build --prefix dashboard",
    "start": "npm run start --prefix dashboard"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.2"
  },
  "keywords": [
    "terminal-3",
    "tee",
    "intel-sgx",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "autonomous-agent",
    "xendit",
    "verifiable-credentials",
    "ai-tinkerers",
    "gemini"
  ],
  "author": "Bashar & VaultPay Contributors",
  "license": "MIT"
}
